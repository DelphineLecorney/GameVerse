@inherits LayoutComponentBase

<div class="auth-bar">
    @if (AuthState.IsAuthenticated)
    {
        <p>Connecté en tant que <strong>@AuthState.Username</strong></p>
        <button class="btn btn-danger logout-btn" @onclick="LogoutUser">Se déconnecter</button>
    }
    else
    {
        <p>Non connecté</p>
    }
</div>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
