@page "/register"
@inherits RegisterBase

<div class="register-container">
    <h2>Créer un compte</h2>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="error-message">@ErrorMessage</div>
    }

    <!-- Champ fake pour bloquer l'autofill car l'email se mettait sur le username, à voir plus tard -->
    <input style="display:none" autocomplete="off" />

    <div class="form-group">
        <label>Email</label>
        <input type="email" class="form-control" @bind="Email" autocomplete="email" />
    </div>

    <div class="form-group">
        <label>Nom d'utilisateur</label>
        <input type="text" class="form-control" @bind="Username" autocomplete="username" />
    </div>

    <div class="form-group">
        <label>Mot de passe</label>
        <input type="password" class="form-control" @bind="Password" autocomplete="new-password" />
    </div>

    <div class="form-group">
        <label>Confirmer le mot de passe</label>
        <input type="password" class="form-control" @bind="ConfirmPassword" autocomplete="new-password" />
    </div>

    <button class="btn btn-primary register-btn" @onclick="RegisterUser">
        S'inscrire
    </button>
</div>
