@page "/not-found"
@layout MainLayout

<div class="notfound-container">
    <div class="notfound-code">404</div>
    <h2 class="notfound-title">Game Over</h2>
    <p class="notfound-text">
        Cette page n'existe pas dans notre bibliothèque.<br />
        Peut-être qu'elle a été retirée de l'inventaire ?
    </p>

    <div class="notfound-actions">
        <a href="/" class="btn-app btn-app-primary">Retour à l'accueil</a>
        <a href="/library" class="btn-app btn-app-secondary">Voir ma bibliothèque</a>
    </div>
</div>