@page "/game/{GameId:int}"

@if (HasError)
{
    <p class="error-message">Impossible de contacter le serveur. Vérifier que l'API est démarrée, puis réessayer.</p>
}
else if (Game == null)
{
    <div class="details-container">
        <div class="cover-skeleton"></div>
        <div class="app-panel info-panel">
            <div class="skeleton-line skeleton-title"></div>
            <div class="skeleton-line"></div>
            <div class="skeleton-line"></div>
            <div class="skeleton-line short"></div>
        </div>
    </div>
}
else
{
    <h2 class="title">@Game.Title</h2>

    <div class="details-container">
        <img src="@Game.CoverUrl" class="cover-large" alt="Jaquette de @Game.Title" />

        <div class="app-panel info-panel">
            <h3>Description</h3>
            <p>@(string.IsNullOrWhiteSpace(Game.Description) ? "Aucune description disponible." : Game.Description)</p>

            <div class="meta">
                <span class="meta-label">Genre</span>
                <span class="meta-value">@Game.Genre</span>

                <span class="meta-label">Date de sortie</span>
                <span class="meta-value">@(Game.ReleaseDate?.ToString("dd MMM yyyy") ?? "—")</span>

                <span class="meta-label">Développeur</span>
                <span class="meta-value">@(string.IsNullOrWhiteSpace(Game.Developer) ? "—" : Game.Developer)</span>

                <span class="meta-label">Éditeur</span>
                <span class="meta-value">@(string.IsNullOrWhiteSpace(Game.Publisher) ? "—" : Game.Publisher)</span>
            </div>

            <div class="details-actions">
                <button class="btn-app btn-app-primary" @onclick='() => AddTo("Library")'>
                    Ajouter à ma bibliothèque
                </button>
                <button class="btn-app btn-app-secondary" @onclick='() => AddTo("Wishlist")'>
                    Ajouter à ma wishlist
                </button>
                <button class="btn-app @(Game.IsFavorite ? "btn-app-primary" : "btn-app-secondary")"
                        @onclick="ToggleFavorite">
                    @(Game.IsFavorite ? "★ Favori" : "☆ Favori")
                </button>
            </div>

            @if (Game.RelationType == "Library")
            {
                <div class="rating-section">
                    <label for="ratingSelect">Ma note</label>
                    <select id="ratingSelect" class="form-control rating-select" value="@Game.Rating" @onchange="OnRatingChanged">
                        <option value="">— Non noté —</option>
                        @for (int i = 0; i <= 10; i++)
                        {
                            <option value="@i" selected="@(Game.Rating == i)">@i / 10</option>
                        }
                    </select>
                </div>
            }

            <button class="btn-app btn-app-secondary" @onclick="GoBack">
                <span aria-hidden="true">←</span> Retour à la bibliothèque
            </button>
        </div>
    </div>
}

@if (ToastMessage != null)
{
    <div class="toast-notification">@ToastMessage</div>
}