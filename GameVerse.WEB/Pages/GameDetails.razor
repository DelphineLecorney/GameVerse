@page "/game/{GameId:int}"

@if (Game == null)
{
    <div class="details-container">
        <div class="cover-skeleton"></div>
        <div class="app-panel info-panel">
            <div class="skeleton-line skeleton-title"></div>
            <div class="skeleton-line"></div>
            <div class="skeleton-line"></div>
            <div class="skeleton-line short"></div>
        </div>
    </div>
}
else
{
    <h2 class="title">@Game.Title</h2>

    <div class="details-container">
        <img src="@Game.CoverUrl" class="cover-large" alt="Jaquette de @Game.Title" />

        <div class="app-panel info-panel">
            <h3>Description</h3>
            <p>@(string.IsNullOrWhiteSpace(Game.Description) ? "Aucune description disponible." : Game.Description)</p>

            <div class="meta">
                <span class="meta-label">Genre</span>
                <span class="meta-value">@Game.Genre</span>

                <span class="meta-label">Date de sortie</span>
                <span class="meta-value">@(Game.ReleaseDate?.ToString("dd MMM yyyy") ?? "—")</span>

                <span class="meta-label">Développeur</span>
                <span class="meta-value">@(string.IsNullOrWhiteSpace(Game.Developer) ? "—" : Game.Developer)</span>

                <span class="meta-label">Éditeur</span>
                <span class="meta-value">@(string.IsNullOrWhiteSpace(Game.Publisher) ? "—" : Game.Publisher)</span>
            </div>

            <button class="btn-app btn-app-secondary" @onclick="GoBack">
                <span aria-hidden="true">←</span> Retour à la bibliothèque
            </button>
        </div>
    </div>
}