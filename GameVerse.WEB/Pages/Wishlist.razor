@using Microsoft.AspNetCore.Authorization

@page "/wishlist"
@attribute [Authorize]

<h2 class="page-title">Ma liste de souhaits</h2>

@if (HasError)
{
    <p class="error-message">Impossible de contacter le serveur. Vérifier que l'API est démarrée, puis réessayer.</p>
}
else if (Games == null)
{
    <p class="loading">Chargement...</p>
}
else if (!Games.Any())
{
    <p>Tu n'as pas encore de jeu dans ta liste de souhaits.</p>
}
else
{
    <div class="games-grid">
        @foreach (var game in Games)
        {
            <div class="game-card">
                <img src="@game.CoverUrl" class="cover" />

                <div class="info">
                    <h3>@game.Title</h3>
                    <span class="badge-app">@game.Genre</span>
                </div>

                <div class="actions">
                    <button class="btn-app btn-app-primary" @onclick="() => GoToDetails(game.GameId)">
                        Voir détails
                    </button>

                    <button class="btn-app btn-app-danger" @onclick="() => RemoveFromWishlist(game.GameId)">
                        Retirer
                    </button>
                </div>
            </div>
        }
    </div>
}