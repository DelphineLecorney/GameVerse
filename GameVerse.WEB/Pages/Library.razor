@using Microsoft.AspNetCore.Authorization

@page "/library"
@attribute [Authorize]

<h2 class="page-title">Ma bibliothèque</h2>

@if (Games == null)
{
    <p class="loading">Chargement...</p>
}
else if (!Games.Any())
{
    <p class="empty">Tu n’as encore aucun jeu dans ta bibliothèque.</p>
}
else
{
    <div class="games-grid">
        @foreach (var game in Games)
        {
            <div class="game-card">
                <img src="@game.CoverUrl" class="cover" />

                <div class="info">
                    <h3>@game.Title</h3>
                    <p class="genre">@game.Genre</p>
                </div>

                <div class="actions">
                    <button class="details-btn" @onclick="() => GoToDetails(game.GameId)">
                        Voir détails
                    </button>

                    <button class="remove-btn" @onclick="() => RemoveFromLibrary(game.GameId)">
                        Retirer
                    </button>
                </div>
            </div>
        }
    </div>
}
