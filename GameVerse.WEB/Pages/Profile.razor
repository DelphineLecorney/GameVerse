@using Microsoft.AspNetCore.Authorization

@page "/profile"
@attribute [Authorize]

@if (User == null)
{
    <div class="loading">Chargement du profil...</div>
}
else
{
    <div class="profile-wrapper">

        <div class="profile-header">
            <img src="img/avatar-default.png" class="avatar" />
            <h2>@User.Username</h2>
            <span class="email">@User.Email</span>
        </div>

        <div class="profile-grid">

            <div class="profile-card">
                <h3>Date d’inscription</h3>
                <p>@User.CreatedAt.ToShortDateString()</p>
            </div>

            @* <div class="profile-card">
                <h3>Dernière connexion</h3>
                <p>@User.LastLogin?.ToShortDateString()</p>
            </div>

            <div class="profile-card">
                <h3>Rôle</h3>
                <p>@User.Role</p>
            </div> *@

        </div>



        <button class="edit-btn">Modifier le profil</button>
    </div>
}
