@using Microsoft.AspNetCore.Authorization

@page "/favorites"
@attribute [Authorize]

<h2 class="page-title">Mes favoris</h2>

@if (HasError)
{
    <p class="error-message">Impossible de contacter le serveur. Vérifie que l'API est démarrée, puis réessaie.</p>
}
else if (Games == null)
{
    <p class="loading">Chargement...</p>
}
else if (!Games.Any())
{
    <p>Tu n'as pas encore de jeu en favori.</p>
}
else
{
    <div class="games-grid">
        @foreach (var game in Games)
        {
            <div class="game-card">
                <img src="@game.CoverUrl" class="cover" />

                <div class="info">
                    <h3>@game.Title</h3>
                    <span class="badge-app">@game.Genre</span>
                </div>

                <div class="actions">
                    <button class="btn-app btn-app-primary" @onclick="() => GoToDetails(game.GameId)">
                        Voir détails
                    </button>

                    <button class="btn-app btn-app-danger" @onclick="() => AskRemoveConfirmation(game.GameId, game.Title)">
                        Retirer
                    </button>
                </div>
            </div>
        }
    </div>
}

<ConfirmModal IsVisible="ShowConfirmModal"
              Title="Retirer ce jeu ?"
              Message="@ConfirmMessage"
              ConfirmLabel="Retirer"
              OnConfirm="ConfirmRemove"
              OnCancel="CancelRemove" />